<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_spool_weigh_wizard_form" model="ir.ui.view">
        <field name="name">imago.spool.weigh.wizard.form</field>
        <field name="model">imago.spool.weigh.wizard</field>
        <field name="arch" type="xml">
            <form string="Pesar carrete">
                <group>
                    <group>
                        <field name="lot_id" options="{'no_create': True}"/>
                        <field name="gross_weight_g"/>
                        <field name="tare_g"/>
                    </group>
                    <group>
                        <field name="net_g"/>
                        <field name="current_g"/>
                        <field name="diff_g"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Ajustar carrete" class="btn-primary"/>
                    <button string="Descartar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_spool_weigh_wizard" model="ir.actions.act_window">
        <field name="name">Pesar carrete</field>
        <field name="res_model">imago.spool.weigh.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
