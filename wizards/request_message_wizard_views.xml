<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_request_message_wizard_form" model="ir.ui.view">
        <field name="name">imago.print.request.message.wizard.form</field>
        <field name="model">imago.print.request.message.wizard</field>
        <field name="arch" type="xml">
            <form string="Mensaje al solicitante">
                <field name="request_id" invisible="1"/>
                <field name="mode" invisible="1"/>
                <p attrs="{'invisible': [('mode', '!=', 'info')]}">
                    La solicitud pasará a <strong>Aclarar</strong> y el solicitante recibirá este mensaje.
                </p>
                <p attrs="{'invisible': [('mode', '!=', 'reject')]}">
                    La solicitud quedará <strong>Rechazada</strong> y el solicitante recibirá el motivo.
                </p>
                <field name="message" placeholder="Escribe el mensaje…"/>
                <footer>
                    <button name="action_confirm" type="object" string="Enviar" class="btn-primary"/>
                    <button string="Descartar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
