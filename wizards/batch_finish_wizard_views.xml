<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_batch_finish_wizard_form" model="ir.ui.view">
        <field name="name">imago.print.batch.finish.wizard.form</field>
        <field name="model">imago.print.batch.finish.wizard</field>
        <field name="arch" type="xml">
            <form string="Terminar impresión combinada">
                <field name="batch_id" invisible="1"/>
                <group>
                    <group>
                        <field name="workcenter_id"/>
                        <field name="plate_result" widget="radio"/>
                        <field name="print_minutes"/>
                        <field name="print_date_start"/>
                        <field name="print_date_end"/>
                        <field name="labor_minutes"/>
                    </group>
                    <group attrs="{'invisible': [('plate_result', 'not in', ('partial', 'failed', 'cancelled'))]}">
                        <field name="failure_reason"/>
                        <field name="failure_note" attrs="{'required': [('failure_reason', '=', 'other')]}"/>
                    </group>
                </group>
                <separator string="Consumo por carrete (total de la placa)"/>
                <field name="lot_line_ids">
                    <tree editable="bottom">
                        <field name="lot_id" options="{'no_create': True}"/>
                        <field name="available_g"/>
                        <field name="grams"/>
                    </tree>
                </field>
                <separator string="Resultado y reparto por solicitud"/>
                <field name="request_line_ids">
                    <tree editable="bottom" create="false" delete="false">
                        <field name="job_id" invisible="1" force_save="1"/>
                        <field name="request_id"/>
                        <field name="pieces_planned"/>
                        <field name="result"/>
                        <field name="pieces_ok"/>
                        <field name="failure_reason" attrs="{'required': [('result', 'in', ('partial', 'failed'))]}"/>
                        <field name="failure_note" attrs="{'required': [('failure_reason', '=', 'other')]}"/>
                        <field name="share_pct" sum="Total"/>
                    </tree>
                </field>
                <p class="text-muted">
                    Los gramos de cada carrete, los minutos de máquina y la mano de obra se reparten según la
                    parte de cada solicitud. El reparto debe sumar 100 %.
                </p>
                <footer>
                    <button name="action_finish" type="object" string="Terminar impresión combinada"
                            class="btn-primary"/>
                    <button string="Descartar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
