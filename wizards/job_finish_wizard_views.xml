<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_job_finish_wizard_form" model="ir.ui.view">
        <field name="name">imago.print.job.finish.wizard.form</field>
        <field name="model">imago.print.job.finish.wizard</field>
        <field name="arch" type="xml">
            <form string="Terminar intento">
                <field name="job_id" invisible="1"/>
                <field name="request_id" invisible="1"/>
                <field name="cancel_request" invisible="1"/>
                <div class="alert alert-info" role="alert" attrs="{'invisible': [('cancel_request', '=', False)]}">
                    Al terminar este intento, la solicitud se cancelará.
                </div>
                <group>
                    <group>
                        <field name="result" widget="radio"/>
                        <field name="pieces_planned"/>
                        <field name="pieces_ok"/>
                        <field name="print_minutes"/>
                        <field name="print_date_start"/>
                        <field name="print_date_end"/>
                        <field name="labor_minutes"/>
                    </group>
                    <group attrs="{'invisible': [('result', 'not in', ('partial', 'failed', 'cancelled'))]}">
                        <field name="failure_reason" attrs="{'required': [('result', 'in', ('partial', 'failed'))]}"/>
                        <field name="failure_note" attrs="{'required': [('failure_reason', '=', 'other')]}"/>
                    </group>
                </group>
                <field name="line_ids">
                    <tree editable="bottom">
                        <field name="lot_id" options="{'no_create': True}"/>
                        <field name="available_g"/>
                        <field name="grams"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_finish" type="object" string="Terminar intento" class="btn-primary"/>
                    <button string="Descartar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
