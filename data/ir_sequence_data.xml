<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_print_request" model="ir.sequence">
        <field name="name">Solicitud de impresión 3D</field>
        <field name="code">imago.print.request</field>
        <field name="prefix">PRT-%(year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_print_batch" model="ir.sequence">
        <field name="name">Impresión combinada 3D</field>
        <field name="code">imago.print.batch</field>
        <field name="prefix">PRB-%(year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_spool" model="ir.sequence">
        <field name="name">Carrete de filamento</field>
        <field name="code">imago.spool</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
