<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Categoría y grupos -->
    <record id="module_category_print3d" model="ir.module.category">
        <field name="name">Impresión 3D</field>
        <field name="description">Solicitudes de impresión 3D, impresoras y carretes de filamento.</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_print_requester" model="res.groups">
        <field name="name">Solicitante</field>
        <field name="category_id" ref="module_category_print3d"/>
    </record>

    <record id="group_print_operator" model="res.groups">
        <field name="name">Operador de impresión 3D</field>
        <field name="category_id" ref="module_category_print3d"/>
        <field name="implied_ids" eval="[(4, ref('group_print_requester')), (4, ref('mrp.group_mrp_user')), (4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_print_manager" model="res.groups">
        <field name="name">Responsable de impresión 3D</field>
        <field name="category_id" ref="module_category_print3d"/>
        <field name="implied_ids" eval="[(4, ref('group_print_operator'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Todo usuario interno es solicitante -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_print_requester'))]"/>
    </record>

    <!-- Reglas multi-compañía -->
    <!-- Usuario técnico del puente local (SPEC 16.8): sin menús, solo la API del puente -->
    <record id="group_print_bridge" model="res.groups">
        <field name="name">Puente de impresoras (técnico)</field>
        <field name="category_id" ref="module_category_print3d"/>
        <field name="comment">Solo para el usuario técnico del puente local: get_config y push_telemetry.</field>
    </record>

    <record id="rule_printer_bridge_company" model="ir.rule">
        <field name="name">Puente de impresoras: multi-compañía</field>
        <field name="model_id" ref="model_imago_printer_bridge"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_printer_status_company" model="ir.rule">
        <field name="name">Estado de impresora: multi-compañía</field>
        <field name="model_id" ref="model_imago_printer_status"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_printer_event_company" model="ir.rule">
        <field name="name">Evento de impresora: multi-compañía</field>
        <field name="model_id" ref="model_imago_printer_event"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_print_request_company" model="ir.rule">
        <field name="name">Solicitud de impresión 3D: multi-compañía</field>
        <field name="model_id" ref="model_imago_print_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_print_job_company" model="ir.rule">
        <field name="name">Intento de impresión 3D: multi-compañía</field>
        <field name="model_id" ref="model_imago_print_job"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_print_consumption_company" model="ir.rule">
        <field name="name">Consumo de filamento: multi-compañía</field>
        <field name="model_id" ref="model_imago_print_consumption"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_print_batch_company" model="ir.rule">
        <field name="name">Impresión combinada 3D: multi-compañía</field>
        <field name="model_id" ref="model_imago_print_batch"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Solicitante: lee todas (sin regla de lectura), escribe solo las propias en borrador/aclarar -->
    <record id="rule_print_request_requester_own" model="ir.rule">
        <field name="name">Solicitud de impresión 3D: el solicitante edita las propias</field>
        <field name="model_id" ref="model_imago_print_request"/>
        <field name="groups" eval="[(4, ref('group_print_requester'))]"/>
        <field name="domain_force">[('requester_id', '=', user.id), ('state', 'in', ('draft', 'needs_info'))]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Operador / Responsable: todas -->
    <record id="rule_print_request_operator_all" model="ir.rule">
        <field name="name">Solicitud de impresión 3D: el operador gestiona todas</field>
        <field name="model_id" ref="model_imago_print_request"/>
        <field name="groups" eval="[(4, ref('group_print_operator'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
